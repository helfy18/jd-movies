// Build settings shared by the JD Movies app target.
//
// Secrets.xcconfig is git-ignored. Copy Secrets.example.xcconfig to Secrets.xcconfig
// and fill in your TMDB key; the app still runs without it, minus theatre listings,
// unrated movie details and person bios.
#include? "Secrets.xcconfig"

// xcconfig treats "//" as a comment, so the scheme separator is split with $().
JD_RATINGS_API_BASE_URL = https:/$()/rival-rodie-helfy18-8da32b7b.koyeb.app
JD_SITE_BASE_URL = https:/$()/jd-movies.netlify.app
